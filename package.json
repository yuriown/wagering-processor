{
  "name": "wagering-processor",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun src/main.ts",
    "dev": "bun --watch src/main.ts",
    "infra:up": "docker compose up -d --wait postgres sqs && docker compose run --rm sqs-init",
    "infra:down": "docker compose down -v",
    "db:migrate": "bun scripts/migrate.ts up",
    "db:rollback": "bun scripts/migrate.ts down",
    "db:status": "bun scripts/migrate.ts status",
    "sqs:send": "bun scripts/send-wager.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration test/http",
    "test:multiprocess": "bun test test/multiprocess"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1148.0",
    "@mikro-orm/core": "^7.2.4",
    "@mikro-orm/migrations": "^7.2.4",
    "@mikro-orm/postgresql": "^7.2.4",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/express": "^5.0.6",
    "typescript": "^7.0.2"
  }
}
